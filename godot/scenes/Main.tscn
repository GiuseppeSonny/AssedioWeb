[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.08, 0.05, 1)

[node name="VBoxContainer" type="VBoxContainer" parent="."]
anchors_preset = 8
